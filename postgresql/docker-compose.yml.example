services:
  db:
    image: postgres:16-alpine
    container_name: mapa_django_pg
    restart: always
    environment:
      POSTGRES_DB: myproject_db
      POSTGRES_USER: myproject_user
      POSTGRES_PASSWORD: mysecretpassword
    ports:
      - "5432:5432"
    volumes:
      - mapa_postgres_data:/var/lib/postgresql/data

volumes:
  mapa_postgres_data: